<?xml version="1.0" encoding="utf-8"?>
<!--
  ZFPlus as a per-user Windows Installer package, built with wixl
  (msitools) so it can be made on Linux.

  - Installs zapfast.exe to %LOCALAPPDATA%\Programs\ZFPlus, per user, so
    no administrator rights are needed. Start menu and desktop shortcuts.
  - zapfast-installer.txt tells the updater this copy came from an installer,
    so an update installs the next package silently over it.
  - Lives beside the official ZapFast without touching it; both use the same
    chats and login, but only one of them runs at a time.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="ZFPlus" Manufacturer="ZFPlus"
    Version="$(var.Version)" UpgradeCode="{6E3B1A52-6B0B-4C7E-9E0A-1F2D7C5A9B31}"
    Language="1033">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser"
      Description="ZFPlus" />
    <MajorUpgrade AllowSameVersionUpgrades="yes"
      DowngradeErrorMessage="A newer version of ZFPlus is already installed." />
    <Media Id="1" Cabinet="zapfast.cab" EmbedCab="yes" />
    <Icon Id="ZFPlusIcon" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="ZFPlusIcon" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="REINSTALLMODE" Value="amus" />
    <Property Id="ALLUSERS" Value="2" />
    <Property Id="MSIINSTALLPERUSER" Value="1" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="UserPrograms" Name="Programs">
          <Directory Id="INSTALLFOLDER" Name="ZFPlus">
            <Component Id="Program" Guid="{3F7B2C91-0D4E-4B8A-9C61-7E2A5D9F1B04}" Win64="yes">
              <File Id="ZapFastExe" Name="zapfast.exe" Source="$(var.SourceDir)/zapfast.exe" />
              <File Id="InstallerMarker" Name="zapfast-installer.txt"
                Source="$(var.SourceDir)/zapfast-installer.txt" />
              <File Id="Readme" Name="README-ZFPlus.txt"
                Source="$(var.SourceDir)/README-ZFPlus.txt" />
              <RegistryValue Root="HKCU" Key="Software\ZFPlus" Name="InstallFolder"
                Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
              <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
            </Component>
          </Directory>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Component Id="StartMenuShortcut" Guid="{A1C4E8D2-5B7F-4E3A-8D90-2C6B1F4E7A55}">
          <Shortcut Id="StartMenuZFPlus" Name="ZFPlus" Description="WhatsApp, native and fast, with Enhancements"
            Target="[INSTALLFOLDER]zapfast.exe" WorkingDirectory="INSTALLFOLDER" Icon="ZFPlusIcon" />
          <RegistryValue Root="HKCU" Key="Software\ZFPlus" Name="StartMenuShortcut"
            Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
      <Directory Id="DesktopFolder">
        <Component Id="DesktopShortcut" Guid="{C9D2B7E4-1A3F-4C6E-B8D5-9F0A2E4C6B17}">
          <Shortcut Id="DesktopZFPlus" Name="ZFPlus" Description="WhatsApp, native and fast, with Enhancements"
            Target="[INSTALLFOLDER]zapfast.exe" WorkingDirectory="INSTALLFOLDER" Icon="ZFPlusIcon" />
          <RegistryValue Root="HKCU" Key="Software\ZFPlus" Name="DesktopShortcut"
            Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </Directory>

    <Feature Id="Main" Level="1">
      <ComponentRef Id="Program" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
  </Product>
</Wix>
