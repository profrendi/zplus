<?xml version="1.0" encoding="utf-8"?>
<!--
  ZFPlus Nightly as a per-user Windows Installer package, built with wixl
  (msitools) so it can be made on Linux. ZFPlus Nightly is its own app:
  its own product code, folder, shortcuts, chats and login, so it installs
  and runs beside ZFPlus without touching it.

  - Installs zfplus-nightly.exe to %LOCALAPPDATA%\Programs\ZFPlus Nightly,
    per user, so no administrator rights are needed.
  - zfplus-nightly-installer.txt tells the updater this copy came from an
    installer, so an update installs the next package silently over it.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="ZFPlus Nightly" Manufacturer="ZFPlus"
    Version="$(var.Version)" UpgradeCode="{C45D724D-F07C-40FE-867C-AC37FE8815E6}"
    Language="1033">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser"
      Description="ZFPlus Nightly" />
    <MajorUpgrade AllowSameVersionUpgrades="yes"
      DowngradeErrorMessage="A newer ZFPlus Nightly is already installed." />
    <Media Id="1" Cabinet="zfplus-nightly.cab" EmbedCab="yes" />
    <Icon Id="ZFPlusIcon" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="ZFPlusIcon" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="REINSTALLMODE" Value="amus" />
    <Property Id="ALLUSERS" Value="2" />
    <Property Id="MSIINSTALLPERUSER" Value="1" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="UserPrograms" Name="Programs">
          <Directory Id="INSTALLFOLDER" Name="ZFPlus Nightly">
            <Component Id="Program" Guid="{46FDBAE6-6551-4D72-B625-A05C3E1DF486}" Win64="yes">
              <File Id="ZapFastExe" Name="zfplus-nightly.exe" Source="$(var.SourceDir)/zfplus-nightly.exe" />
              <File Id="InstallerMarker" Name="zfplus-nightly-installer.txt"
                Source="$(var.SourceDir)/zfplus-nightly-installer.txt" />
              <File Id="Readme" Name="README-ZFPlus.txt"
                Source="$(var.SourceDir)/README-ZFPlus.txt" />
              <RegistryValue Root="HKCU" Key="Software\ZFPlus Nightly" Name="InstallFolder"
                Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
              <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
            </Component>
          </Directory>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Component Id="StartMenuShortcut" Guid="{0CF2989C-47AF-4D15-9D0D-42DFAB057848}">
          <Shortcut Id="StartMenuZFPlusNightly" Name="ZFPlus Nightly" Description="ZFPlus on ZapFast's newest work, before its release"
            Target="[INSTALLFOLDER]zfplus-nightly.exe" WorkingDirectory="INSTALLFOLDER" Icon="ZFPlusIcon" />
          <RegistryValue Root="HKCU" Key="Software\ZFPlus Nightly" Name="StartMenuShortcut"
            Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
      <Directory Id="DesktopFolder">
        <Component Id="DesktopShortcut" Guid="{9B6E5D5E-E45F-4899-B866-85B4D33FB274}">
          <Shortcut Id="DesktopZFPlusNightly" Name="ZFPlus Nightly" Description="ZFPlus on ZapFast's newest work, before its release"
            Target="[INSTALLFOLDER]zfplus-nightly.exe" WorkingDirectory="INSTALLFOLDER" Icon="ZFPlusIcon" />
          <RegistryValue Root="HKCU" Key="Software\ZFPlus Nightly" Name="DesktopShortcut"
            Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </Directory>

    <Feature Id="Main" Level="1">
      <ComponentRef Id="Program" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
  </Product>
</Wix>
